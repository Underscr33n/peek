{
  "manifest_version": 3,
  "name": "Peek",
  "version": "1.1",
  "description": "Clic droit sur une image, ou clic sur l'icône pour choisir plusieurs images de la page",
  "permissions": ["contextMenus", "storage", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "options_page": "options.html",
  "action": { "default_title": "Peek", "default_popup": "popup.html" }
}
